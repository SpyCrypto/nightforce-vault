// IntelVault.compact — Nightforce Intel Vault
// Midnight Compact Contract (v0.x skeleton)
//
// Implements:
//   - Private intelligence report storage (private state)
//   - Commitment-based public indexing
//   - Witness-based verification
//   - Confidence scoring

pragma language_version >= 0.16.0;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

export type ReportId = Bytes<12>;

export struct ReportSummary {
  reportId:          ReportId;
  commitment:        Field;
  verificationCount: Uint64;
  createdAt:         Uint64;
}

export struct PrivateReport {
  title:     Bytes<256>;
  category:  Bytes<64>;
  details:   Bytes<1024>;
  riskLevel: Uint8;
}

// ---------------------------------------------------------------------------
// Ledger (public state on-chain)
// ---------------------------------------------------------------------------

ledger reports: Map<ReportId, ReportSummary>;

// Private state is managed off-ledger via Midnight's shielded state model.
// In a full implementation, reportDetails would live in the Midnight
// shielded data store, indexed by (walletKey, reportId).

// ---------------------------------------------------------------------------
// Commitment helper
// Preimage: poseidon(titleField || detailsField || saltField)
// ---------------------------------------------------------------------------

witness computeCommitment(
  title:   Bytes<256>,
  details: Bytes<1024>,
  salt:    Field
): Field;

// ---------------------------------------------------------------------------
// Circuit: createReport
// Inputs (private):
//   title, category, details, riskLevel, salt
// Public outputs:
//   stores ReportSummary on ledger (commitment, timestamp, count=0)
// ---------------------------------------------------------------------------

export circuit createReport(
  reportId:  ReportId,
  title:     Bytes<256>,
  category:  Bytes<64>,
  details:   Bytes<1024>,
  riskLevel: Uint8,
  salt:      Field
): [] {
  const commitment: Field = computeCommitment(title, details, salt);

  const summary: ReportSummary = ReportSummary {
    reportId:          reportId,
    commitment:        commitment,
    verificationCount: 0 as Uint64,
    createdAt:         currentTime() as Uint64,
  };

  reports.insert(reportId, summary);
}

// ---------------------------------------------------------------------------
// Circuit: verifyReport  (Witness Verification)
// Inputs (private):
//   reportId — identifies which report to verify
//   title, details, salt — witness knowledge
// Public effect:
//   verificationCount++ on the public ReportSummary
// ---------------------------------------------------------------------------

export circuit verifyReport(
  reportId: ReportId,
  title:    Bytes<256>,
  details:  Bytes<1024>,
  salt:     Field
): [] {
  const summary: ReportSummary = reports.lookup(reportId);

  const witnessCommitment: Field = computeCommitment(title, details, salt);

  // Zero-knowledge assertion: witness matches stored commitment
  assert witnessCommitment == summary.commitment : "Witness does not match commitment";

  const updated: ReportSummary = ReportSummary {
    reportId:          summary.reportId,
    commitment:        summary.commitment,
    verificationCount: summary.verificationCount + (1 as Uint64),
    createdAt:         summary.createdAt,
  };

  reports.insert(reportId, updated);
}

// ---------------------------------------------------------------------------
// Query: getSummary
// Returns public information only. No private details exposed.
// ---------------------------------------------------------------------------

export circuit getSummary(reportId: ReportId): ReportSummary {
  return reports.lookup(reportId);
}
